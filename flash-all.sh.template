#!/usr/bin/env bash
# Auto-generated by GitHub Actions build job. Do not edit by hand.
set -euo pipefail

BUILD_TAG="__BUILD_TAG__"
BUILD_DATE="__BUILD_DATE__"

echo "=========================================="
echo " Redfin FART12 build: ${BUILD_TAG}"
echo " Build date: ${BUILD_DATE}"
echo "=========================================="
echo ""
echo "This script flashes a Pixel 5 (redfin) with factory images + a custom"
echo "boot.img containing fart12-lite (ART-based DexProtector dump support)"
echo "targeting com.sacombankpay."
echo ""
echo "boot.img was built from AOSP 12.1.0_r2 with fart12-lite patches."
echo "system.img, vendor.img, bootloader.img, radio.img come from the official"
echo "Google factory image and are unmodified."
echo ""

if ! command -v fastboot >/dev/null 2>&1; then
  echo "ERROR: fastboot not found in PATH" >&2
  exit 1
fi

DEVICE=$(fastboot devices | awk '{print $1}' | head -1)
if [ -z "${DEVICE}" ]; then
  echo "ERROR: no device in fastboot mode. Reboot to bootloader and retry." >&2
  exit 1
fi

echo "[1/6] Flashing bootloader..."
fastboot flash bootloader bootloader-redfin-*.img
fastboot reboot-bootloader
sleep 2

echo "[2/6] Flashing radio (modem)..."
fastboot flash radio radio-redfin-*.img 2>/dev/null || echo "  (no radio — OK for redfin)"

echo "[3/6] (vbmeta skipped — using AVB disabled via build flag)..."

# Android 12+ uses dynamic partitions (super). system.img + vendor.img are
# logical partitions under super; flashing them in bootloader mode fails with
# "Partition should be flashed in fastbootd". Reboot into fastbootd first.
echo "[4/6] Rebooting into fastbootd for dynamic partitions..."
fastboot reboot fastboot
sleep 3

echo "[5/6] Flashing factory system.img + vendor.img (in fastbootd)..."
fastboot flash vendor vendor.img
fastboot flash system system.img

echo "[6/6] Flashing custom boot.img (FART-modified ART)..."
fastboot flash boot boot-aosp-fart.img

echo ""
echo "=========================================="
echo " Flash complete."
echo ""
echo " Post-flash steps:"
echo "  1. fastboot reboot"
echo "  2. adb push f1rt.config /data/local/tmp/f1rt.config"
echo "  3. adb shell setprop persist.sys.usb.config mtp,adb"
echo "  4. adb shell am start -n com.sacombankpay/.MainVer2Activity"
echo "  5. Wait 60 seconds for FART trigger"
echo "  6. adb pull /data/data/com.sacombankpay/zskkk/"
echo "=========================================="
