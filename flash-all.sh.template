echo "[3/4] Flashing boot..."
fastboot flash boot boot.img

echo "[4/4] Flashing system + vendor..."
fastboot flash system system.img
fastboot flash vendor vendor-redfin-*.img

echo ""
echo "=========================================="
echo " Flash complete."
echo ""
echo " Post-flash steps:"
echo "  1. fastboot reboot"
echo "  2. adb push f1rt.config /data/local/tmp/f1rt.config"
